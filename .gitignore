# macOS
.DS_Store

# Secrets — these never belong in the repo. Keys and certs go to 1Password.
.env
.env*.local
*.pem

# Can hold secrets inside allow rules
.claude/settings.local.json
.claude/worktrees/

# tools/README.md says `npm i playwright` for the two browser tests, and there
# is no package.json to put it under — so npm drops node_modules/ in the repo
# root. index.html itself still has no dependencies; nothing here ships.
node_modules/
package-lock.json
package.json

# Assets tree: deny by default, allowlist the docs.
# Photography inputs/outputs live here, never in git —
#   in/   irreplaceable originals (scans, historic photo repros)
#   out/  edits and exports worth keeping
#   ref/  expensive to re-fetch (archive downloads, tile caches)
#   work/ churn, never synced
/data/*
!/data/README.md
!/data/.syncignore
